GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PINECONE_API_KEY=
PINECONE_INDEX_NAME=it-support-knowledge
TAVILY_API_KEY=
MERIDIAN_MCP_ENABLED=true
MERIDIAN_BACKEND_DIR=backend
MERIDIAN_BACKEND_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8001/ask
# URL employees use to open the Streamlit app (used in password setup links).
COPILOT_PUBLIC_URL=http://localhost:8501
# Optional persistent login for local runs. Use the same host/scheme as the UI.
# API and UI share BROWSER_UI_AUTH_KEY; only the API needs BROWSER_SESSION_KEY.
COPILOT_BROWSER_AUTH_URL=
BROWSER_UI_AUTH_KEY=
BROWSER_SESSION_KEY=
